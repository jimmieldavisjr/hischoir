# Absolute URL of the NestJS API on Railway. Baked into the client bundle at
# build time, so changing it requires a redeploy.
#
#   Local:      http://localhost:8080
#   Railway:    https://hischoir-api-production-1a2b.up.railway.app
#   Custom:     https://api.hischoir.org
NEXT_PUBLIC_API_URL=http://localhost:8080

# Public URL of this site, used for absolute OpenGraph image URLs.
# Vercel supplies VERCEL_PROJECT_PRODUCTION_URL automatically, so this is only
# needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://hischoir.org
