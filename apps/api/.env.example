# --- Railway service variables -------------------------------------------
# Reference the PostgreSQL service rather than pasting a connection string:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# That resolves to the private network address, so the database is never
# exposed publicly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hischoir
DATABASE_POOL_SIZE=10

# At least 32 random characters. Signs the session cookie.
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSCODE=replace-with-a-strong-director-passcode
TEAM_PASSCODE=replace-with-a-memorable-team-passcode
YOUTUBE_API_KEY=

# --- Cross-origin configuration ------------------------------------------
# Comma-separated list of browser origins allowed to send credentialed
# requests. Must name the Vercel deployment exactly; "*" is rejected.
WEB_ORIGIN=http://localhost:3000

# How the session cookie crosses the origin boundary.
#
#   Different registrable domains (hischoir.vercel.app + *.up.railway.app):
#     COOKIE_SAMESITE=none
#     COOKIE_SECURE=true
#     (leave COOKIE_DOMAIN unset)
#
#   Shared parent domain (hischoir.org + api.hischoir.org) — recommended,
#   because it avoids third-party cookie restrictions entirely:
#     COOKIE_SAMESITE=lax
#     COOKIE_SECURE=true
#     COOKIE_DOMAIN=.hischoir.org
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.hischoir.org

# Railway injects PORT in production.
PORT=8080
